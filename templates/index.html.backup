<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="{{ url_for('static', filename='logo.png') }}">
    <title>HackSmarter Calendar Editor</title>
    <style>
        /* Icon styling */
        .icon {
            display: inline-block;
            margin-right: 10px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
            color: #ffffff;
            min-height: 100vh;
            padding: 20px;
            transition: background 0.3s ease;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
        }
        
        header {
            text-align: center;
            padding: 30px 0;
            border-bottom: 3px solid #00ff88;
            margin-bottom: 30px;
            transition: border-color 0.3s ease;
        }

        .brand-logo {
            width: 48px;
            height: 48px;
            object-fit: contain;
            vertical-align: middle;
            margin-right: 15px;
        }
        
        h1 {
            font-size: 3em;
            color: #00ff88;
            text-shadow: 0 0 20px rgba(0, 255, 136, 0.5);
            margin-bottom: 10px;
            transition: color 0.3s ease, text-shadow 0.3s ease;
        }
        
        .tagline {
            color: #888;
            font-family: 'Courier New', monospace;
            font-size: 1.2em;
        }
        
        .current-date {
            font-size: 1.5em;
            color: #00ff88;
            font-family: 'Courier New', monospace;
            margin: 20px 0;
            text-align: center;
            font-weight: bold;
            transition: color 0.3s ease;
        }
        
        .controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            background: #1a1a1a;
            padding: 20px;
            border-radius: 10px;
            border: 1px solid #333;
            flex-wrap: wrap;
            gap: 15px;
        }
        
        .month-selector, .theme-selector {
            display: flex;
            gap: 15px;
            align-items: center;
        }
        
        button {
            background: #00ff88;
            color: #0a0a0a;
            border: none;
            padding: 12px 24px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            font-size: 16px;
            transition: all 0.3s;
        }
        
        button:hover {
            background: #00cc6a;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 255, 136, 0.3);
        }
        
        button:disabled {
            background: #555;
            cursor: not-allowed;
            transform: none;
        }
        
        .btn-secondary {
            background: #333;
            color: #fff;
        }
        
        .btn-secondary:hover {
            background: #444;
        }
        
        select {
            background: #222;
            color: #fff;
            border: 1px solid #444;
            padding: 10px;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
        }
        
        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 10px;
            margin-bottom: 40px;
        }
        
        .day-header {
            background: #222;
            padding: 15px;
            text-align: center;
            font-weight: bold;
            color: #00ff88;
            border-radius: 5px;
            transition: color 0.3s ease, background 0.3s ease;
        }
        
        .day-cell {
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 5px;
            min-height: 120px;
            padding: 10px;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
        }
        
        .day-cell:hover {
            background: #252525;
            border-color: #00ff88;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 255, 136, 0.2);
        }
        
        .day-cell.empty {
            background: transparent;
            border: none;
            cursor: default;
        }
        
        .day-cell.empty:hover {
            background: transparent;
            transform: none;
            box-shadow: none;
        }
        
        .day-cell.weekend {
            background: #1f1f1f;
        }
        
        .day-number {
            font-size: 1.2em;
            font-weight: bold;
            color: #00ff88;
            margin-bottom: 8px;
            transition: color 0.3s ease;
        }
        
        .event {
            background: rgba(0, 255, 136, 0.1);
            border-left: 3px solid #00ff88;
            padding: 5px 8px;
            margin-top: 5px;
            font-size: 0.85em;
            border-radius: 3px;
            position: relative;
            transition: all 0.3s ease;
        }
        
        .event:hover {
            background: rgba(0, 255, 136, 0.2);
        }
        
        .event-time {
            color: #00ff88;
            font-weight: bold;
            margin-right: 5px;
        }
        
        .event-delete {
            position: absolute;
            right: 5px;
            top: 50%;
            transform: translateY(-50%);
            color: #ff4444;
            cursor: pointer;
            font-weight: bold;
            padding: 2px 6px;
            border-radius: 3px;
            opacity: 0;
            transition: opacity 0.3s;
        }
        
        .event:hover .event-delete {
            opacity: 1;
        }
        
        .event-delete:hover {
            background: rgba(255, 68, 68, 0.2);
        }
        
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        
        .modal.active {
            display: flex;
        }
        
        .modal-content {
            background: #1a1a1a;
            padding: 30px;
            border-radius: 10px;
            border: 2px solid #00ff88;
            max-width: 500px;
            width: 90%;
            box-shadow: 0 10px 40px rgba(0, 255, 136, 0.3);
        }
        
        .modal-header {
            color: #00ff88;
            font-size: 1.5em;
            margin-bottom: 20px;
            text-align: center;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #888;
            font-size: 0.9em;
        }
        
        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 12px;
            background: #222;
            border: 1px solid #444;
            border-radius: 5px;
            color: #fff;
            font-size: 16px;
        }
        
        .form-group textarea {
            resize: vertical;
            min-height: 80px;
        }
        
        .time-input-group {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        
        .time-input-group input {
            flex: 1;
        }
        
        .time-input-group select {
            width: 80px;
        }
        
        .modal-buttons {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }
        
        .modal-buttons button {
            flex: 1;
        }
        
        .generate-section {
            text-align: center;
            margin: 40px 0;
            padding: 30px;
            background: #1a1a1a;
            border-radius: 10px;
            border: 1px solid #333;
        }
        
        .generate-btn {
            background: linear-gradient(135deg, #00ff88 0%, #00cc6a 100%);
            color: #0a0a0a;
            padding: 15px 40px;
            font-size: 18px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(0, 255, 136, 0.3);
        }
        
        .generate-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0, 255, 136, 0.4);
        }
        
        .generate-btn.loading {
            opacity: 0.6;
            cursor: wait;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1><img class="brand-logo" src="{{ url_for('static', filename='logo.png') }}" alt="HackSmarter">HACKSMARTER CALENDAR</h1>
            <p class="tagline">//Hack Smarter - Not Harder</p>
        </header>
        
        <div class="current-date" id="currentDateDisplay"></div>
        
        <div class="controls">
            <div class="month-selector">
                <button onclick="prevMonth()" class="btn-secondary">← Prev</button>
                <select id="monthSelect" onchange="changeMonth()">
                    <option value="1">January</option>
                    <option value="2">February</option>
                    <option value="3">March</option>
                    <option value="4">April</option>
                    <option value="5">May</option>
                    <option value="6">June</option>
                    <option value="7">July</option>
                    <option value="8">August</option>
                    <option value="9">September</option>
                    <option value="10">October</option>
                    <option value="11">November</option>
                    <option value="12">December</option>
                </select>
                <select id="yearSelect" onchange="changeMonth()">
                    <option value="2024">2024</option>
                    <option value="2025">2025</option>
                    <option value="2026" selected>2026</option>
                    <option value="2027">2027</option>
                    <option value="2028">2028</option>
                </select>
                <button onclick="nextMonth()" class="btn-secondary">Next →</button>
            </div>
            <div class="theme-selector">
                <label for="themeSelect" style="color: #888; margin-right: 10px;">Theme:</label>
                <select id="themeSelect" onchange="changeTheme()">
                    <option value="hacker_green">Hacker Green</option>
                    <option value="cyberpunk_purple">Cyberpunk Purple</option>
                    <option value="electric_blue">Electric Blue</option>
                    <option value="hot_pink">Hot Pink</option>
                    <option value="matrix_green">Matrix Green</option>
                    <option value="orange_fire">Orange Fire</option>
                    <option value="neon_yellow">Neon Yellow</option>
                    <option value="red_alert">Red Alert</option>
                    <option value="white_minimal">White Minimal</option>
                </select>
            </div>
            <button onclick="clearAllEvents()" class="btn-secondary">Clear All Events</button>
        </div>
        
        <div class="calendar-grid" id="calendar">
            <!-- Calendar will be generated here -->
        </div>
        
        <div class="generate-section">
            <h2 style="color: #00ff88; margin-bottom: 20px;">
                <img src="{{ url_for('static', filename='logo.png') }}" alt="" width="32" height="32" style="vertical-align: middle; margin-right: 10px; object-fit: contain;">
                DOWNLOAD OPTIONS
            </h2>
            <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;">
                <div style="text-align: center;">
                    <button onclick="generateMonthlyPNG()" class="generate-btn">MONTHLY CALENDAR</button>
                    <p style="color: #888; margin-top: 10px; font-size: 14px;">Full month view with all events</p>
                </div>
                <div style="text-align: center;">
                    <button onclick="generateWeeklyPNG()" class="generate-btn" style="background: linear-gradient(135deg, #ff00ff 0%, #cc00cc 100%);">WEEKLY SCHEDULE</button>
                    <p style="color: #888; margin-top: 10px; font-size: 14px;">Detailed week view (current week)</p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Modal for adding events -->
    <div class="modal" id="eventModal">
        <div class="modal-content">
            <div class="modal-header">Add Event</div>
            <div class="form-group">
                <label>Date</label>
                <input type="text" id="eventDate" readonly>
            </div>
            <div class="form-group">
                <label>Event Title</label>
                <input type="text" id="eventTitle" placeholder="Enter event title" maxlength="200">
            </div>
            <div class="form-group">
                <label>Time (Optional)</label>
                <div class="time-input-group">
                    <input type="number" id="eventHour" placeholder="HH" min="1" max="12" maxlength="2">
                    <input type="number" id="eventMinute" placeholder="MM" min="0" max="59" maxlength="2">
                    <select id="eventAmPm">
                        <option value="AM">AM</option>
                        <option value="PM">PM</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label>Description (Optional)</label>
                <textarea id="eventDescription" placeholder="Enter event description" maxlength="500"></textarea>
            </div>
            <div class="modal-buttons">
                <button onclick="saveEvent()">Save Event</button>
                <button onclick="closeModal()" class="btn-secondary">Cancel</button>
            </div>
        </div>
    </div>
    
    <script>
        let currentMonth = new Date().getMonth() + 1;
        let currentYear = new Date().getFullYear();
        let currentEvents = {};
        let currentModalDate = null;
        let currentTheme = 'hacker_green';
        
        const monthNames = ['', 'January', 'February', 'March', 'April', 'May', 'June', 
                           'July', 'August', 'September', 'October', 'November', 'December'];
        
        // Theme colors configuration
        const themeColors = {
            hacker_green: {
                accent: '#00ff88',
                bg: 'linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%)',
                border: '#00ff88'
            },
            cyberpunk_purple: {
                accent: '#cc66ff',
                bg: 'linear-gradient(135deg, #0a0a0a 0%, #1a0a1a 100%)',
                border: '#cc66ff'
            },
            electric_blue: {
                accent: '#66bbff',
                bg: 'linear-gradient(135deg, #0a0a0a 0%, #0a1a2a 100%)',
                border: '#66bbff'
            },
            hot_pink: {
                accent: '#ff66aa',
                bg: 'linear-gradient(135deg, #0a0a0a 0%, #1a0a1a 100%)',
                border: '#ff66aa'
            },
            matrix_green: {
                accent: '#00ff00',
                bg: 'linear-gradient(135deg, #000000 0%, #001100 100%)',
                border: '#00ff00'
            },
            orange_fire: {
                accent: '#ff9944',
                bg: 'linear-gradient(135deg, #0a0a0a 0%, #1a0a0a 100%)',
                border: '#ff9944'
            },
            neon_yellow: {
                accent: '#ffdd44',
                bg: 'linear-gradient(135deg, #0a0a0a 0%, #1a1a0a 100%)',
                border: '#ffdd44'
            },
            red_alert: {
                accent: '#cc4444',
                bg: 'linear-gradient(135deg, #0a0a0a 0%, #1a0a0a 100%)',
                border: '#cc4444'
            },
            white_minimal: {
                accent: '#000000',
                bg: 'linear-gradient(135deg, #ffffff 0%, #f5f5f5 100%)',
                border: '#000000'
            }
        };
        
        // Change theme dynamically
        function changeTheme() {
            currentTheme = document.getElementById('themeSelect').value;
            const theme = themeColors[currentTheme];
            
            // Update body background
            document.body.style.background = theme.bg;
            
            // Update colors
            const accentColor = theme.accent;
            document.documentElement.style.setProperty('--accent-color', accentColor);
            
            // Update header border
            document.querySelector('header').style.borderBottomColor = accentColor;
            
            // Update h1 color
            document.querySelector('h1').style.color = accentColor;
            document.querySelector('h1').style.textShadow = `0 0 20px ${accentColor}40`;
            
            // Update current date color
            document.querySelector('.current-date').style.color = accentColor;
            
            // Update day headers
            document.querySelectorAll('.day-header').forEach(el => {
                el.style.color = accentColor;
            });
            
            // Update day numbers
            document.querySelectorAll('.day-number').forEach(el => {
                el.style.color = accentColor;
            });
            
            // Update buttons
            document.querySelectorAll('button:not(.btn-secondary)').forEach(btn => {
                if (!btn.classList.contains('generate-btn')) {
                    btn.style.background = accentColor;
                }
            });
            
            // Update events
            document.querySelectorAll('.event').forEach(el => {
                el.style.borderLeftColor = accentColor;
                el.style.background = `${accentColor}1a`;
            });
            
            document.querySelectorAll('.event-time').forEach(el => {
                el.style.color = accentColor;
            });
            
            // Update modal
            document.querySelectorAll('.modal-content').forEach(el => {
                el.style.borderColor = accentColor;
            });
            
            document.querySelectorAll('.modal-header').forEach(el => {
                el.style.color = accentColor;
            });
            
            // Special handling for white_minimal theme
            if (currentTheme === 'white_minimal') {
                document.body.style.color = '#000000';
                document.querySelector('.tagline').style.color = '#666666';
            } else {
                document.body.style.color = '#ffffff';
                document.querySelector('.tagline').style.color = '#888888';
            }
        }
        
        // Update the current date display
        function updateDateDisplay() {
            const display = document.getElementById('currentDateDisplay');
            display.textContent = `${monthNames[currentMonth]} ${currentYear}`;
        }
        
        // Escape HTML to prevent XSS
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        // Convert 12-hour time to 24-hour format
        function convertTo24Hour(hour, minute, ampm) {
            let h = parseInt(hour);
            const m = String(minute).padStart(2, '0');
            
            if (ampm === 'PM' && h !== 12) {
                h += 12;
            } else if (ampm === 'AM' && h === 12) {
                h = 0;
            }
            
            return `${String(h).padStart(2, '0')}:${m}`;
        }
        
        // Convert 24-hour time to 12-hour format
        function convertTo12Hour(time24) {
            if (!time24) return { hour: '', minute: '', ampm: 'AM' };
            
            const [hours, minutes] = time24.split(':').map(Number);
            let hour = hours;
            let ampm = 'AM';
            
            if (hours === 0) {
                hour = 12;
            } else if (hours === 12) {
                ampm = 'PM';
            } else if (hours > 12) {
                hour = hours - 12;
                ampm = 'PM';
            }
            
            return { hour: hour, minute: minutes, ampm: ampm };
        }
        
        // Format time for display
        function formatTimeForDisplay(time24) {
            if (!time24) return '';
            const { hour, minute, ampm } = convertTo12Hour(time24);
            return `${hour}:${String(minute).padStart(2, '0')} ${ampm}`;
        }
        
        // Validate date format YYYY-MM-DD
        function validateDate(dateStr) {
            const pattern = /^\d{4}-\d{2}-\d{2}$/;
            if (!pattern.test(dateStr)) return false;
            
            try {
                const parts = dateStr.split('-');
                const year = parseInt(parts[0]);
                const month = parseInt(parts[1]);
                const day = parseInt(parts[2]);
                
                // Check valid ranges
                if (year < 1900 || year > 2100) return false;
                if (month < 1 || month > 12) return false;
                if (day < 1 || day > 31) return false;
                
                // Create date and verify it's valid
                const date = new Date(year, month - 1, day);
                return date.getFullYear() === year && 
                       date.getMonth() === month - 1 && 
                       date.getDate() === day;
            } catch (e) {
                return false;
            }
        }
        
        // Validate year and month
        function validateMonthYear(month, year) {
            return month >= 1 && month <= 12 && year >= 1900 && year <= 2100;
        }
        
        function initCalendar() {
            document.getElementById('monthSelect').value = currentMonth;
            document.getElementById('yearSelect').value = currentYear;
            updateDateDisplay();
            loadCalendar();
        }
        
        async function loadCalendar() {
            if (!validateMonthYear(currentMonth, currentYear)) {
                console.error('Invalid month or year');
                return;
            }
            
            try {
                const response = await fetch(`/api/calendar/${currentYear}/${currentMonth}`);
                if (!response.ok) {
                    throw new Error('Failed to load calendar');
                }
                const data = await response.json();
                currentEvents = data.events || {};
                renderCalendar(data);
            } catch (error) {
                console.error('Error loading calendar:', error);
                alert('Failed to load calendar. Please try again.');
            }
        }
        
        function renderCalendar(data) {
            const calendar = document.getElementById('calendar');
            calendar.innerHTML = '';
            
            // Day headers
            const days = ['MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN'];
            days.forEach(day => {
                const header = document.createElement('div');
                header.className = 'day-header';
                header.textContent = day;
                calendar.appendChild(header);
            });
            
            // Calendar days
            data.weeks.forEach(week => {
                week.forEach((day, index) => {
                    const cell = document.createElement('div');
                    cell.className = 'day-cell';
                    
                    if (day === 0) {
                        cell.classList.add('empty');
                    } else {
                        if (index >= 5) cell.classList.add('weekend');
                        
                        const dayNum = document.createElement('div');
                        dayNum.className = 'day-number';
                        dayNum.textContent = day;
                        cell.appendChild(dayNum);
                        
                        const dateKey = `${currentYear}-${String(currentMonth).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                        
                        // Add events
                        if (currentEvents[dateKey] && Array.isArray(currentEvents[dateKey])) {
                            currentEvents[dateKey].forEach((event, eventIndex) => {
                                const eventDiv = document.createElement('div');
                                eventDiv.className = 'event';
                                
                                // Sanitize event data
                                const safeTitle = escapeHtml(event.title || '');
                                const timeDisplay = event.time ? formatTimeForDisplay(event.time) : '';
                                
                                const timeSpan = timeDisplay ? `<span class="event-time">${escapeHtml(timeDisplay)}</span> ` : '';
                                const deleteBtn = `<span class="event-delete" data-date="${dateKey}" data-index="${eventIndex}">✕</span>`;
                                
                                eventDiv.innerHTML = `${timeSpan}${safeTitle}${deleteBtn}`;
                                
                                // Add delete handler
                                const deleteSpan = eventDiv.querySelector('.event-delete');
                                deleteSpan.addEventListener('click', function(e) {
                                    e.stopPropagation();
                                    deleteEvent(dateKey, eventIndex);
                                });
                                
                                cell.appendChild(eventDiv);
                            });
                        }
                        
                        cell.addEventListener('click', function() {
                            openModal(dateKey, day);
                        });
                    }
                    
                    calendar.appendChild(cell);
                });
            });
            
            // Apply current theme
            changeTheme();
        }
        
        function openModal(dateKey, day) {
            currentModalDate = dateKey;
            document.getElementById('eventDate').value = `${monthNames[currentMonth]} ${day}, ${currentYear}`;
            document.getElementById('eventTitle').value = '';
            document.getElementById('eventHour').value = '';
            document.getElementById('eventMinute').value = '';
            document.getElementById('eventAmPm').value = 'AM';
            document.getElementById('eventDescription').value = '';
            document.getElementById('eventModal').classList.add('active');
        }
        
        function closeModal() {
            document.getElementById('eventModal').classList.remove('active');
            currentModalDate = null;
        }
        
        async function saveEvent() {
            if (!currentModalDate) return;
            
            const title = document.getElementById('eventTitle').value.trim();
            const hour = document.getElementById('eventHour').value;
            const minute = document.getElementById('eventMinute').value;
            const ampm = document.getElementById('eventAmPm').value;
            const description = document.getElementById('eventDescription').value.trim();
            
            if (!title) {
                alert('Please enter an event title');
                return;
            }
            
            // Convert time to 24-hour format if provided
            let time24 = '';
            if (hour && minute) {
                const h = parseInt(hour);
                const m = parseInt(minute);
                
                if (isNaN(h) || h < 1 || h > 12) {
                    alert('Hour must be between 1 and 12');
                    return;
                }
                
                if (isNaN(m) || m < 0 || m > 59) {
                    alert('Minutes must be between 0 and 59');
                    return;
                }
                
                time24 = convertTo24Hour(h, m, ampm);
            }
            
            const eventData = {
                date: currentModalDate,
                title: title,
                time: time24,
                description: description
            };
            
            try {
                const response = await fetch('/api/events', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(eventData)
                });
                
                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.error || 'Failed to save event');
                }
                
                closeModal();
                await loadCalendar();
            } catch (error) {
                console.error('Error saving event:', error);
                alert(error.message || 'Failed to save event. Please try again.');
            }
        }
        
        async function deleteEvent(dateKey, eventIndex) {
            if (!confirm('Are you sure you want to delete this event?')) {
                return;
            }
            
            try {
                const response = await fetch('/api/events', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        date: dateKey,
                        index: parseInt(eventIndex)
                    })
                });
                
                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.error || 'Failed to delete event');
                }
                
                await loadCalendar();
            } catch (error) {
                console.error('Error deleting event:', error);
                alert(error.message || 'Failed to delete event. Please try again.');
            }
        }
        
        async function clearAllEvents() {
            if (!confirm('Are you sure you want to delete ALL events from ALL dates? This cannot be undone.')) {
                return;
            }
            
            try {
                const response = await fetch('/api/events/clear', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                
                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.error || 'Failed to clear events');
                }
                
                currentEvents = {};
                await loadCalendar();
            } catch (error) {
                console.error('Error clearing events:', error);
                alert(error.message || 'Failed to clear events. Please try again.');
            }
        }
        
        function changeMonth() {
            currentMonth = parseInt(document.getElementById('monthSelect').value);
            currentYear = parseInt(document.getElementById('yearSelect').value);
            updateDateDisplay();
            loadCalendar();
        }
        
        function prevMonth() {
            currentMonth--;
            if (currentMonth < 1) {
                currentMonth = 12;
                currentYear--;
            }
            document.getElementById('monthSelect').value = currentMonth;
            document.getElementById('yearSelect').value = currentYear;
            updateDateDisplay();
            loadCalendar();
        }
        
        function nextMonth() {
            currentMonth++;
            if (currentMonth > 12) {
                currentMonth = 1;
                currentYear++;
            }
            document.getElementById('monthSelect').value = currentMonth;
            document.getElementById('yearSelect').value = currentYear;
            updateDateDisplay();
            loadCalendar();
        }
        
        async function generateMonthlyPNG() {
            if (!validateMonthYear(currentMonth, currentYear)) {
                alert('Invalid month or year');
                return;
            }
            
            const btn = event.target;
            const originalText = btn.textContent;
            btn.textContent = '⏳ Generating...';
            btn.classList.add('loading');
            btn.disabled = true;
            
            try {
                const theme = document.getElementById('themeSelect').value;
                const response = await fetch(`/api/generate/${currentYear}/${currentMonth}?theme=${theme}`);
                
                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.error || 'Failed to generate PNG');
                }
                
                const blob = await response.blob();
                
                if (blob.type !== 'image/png') {
                    throw new Error('Invalid file type received');
                }
                
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `HackSmarter_${monthNames[currentMonth]}_${currentYear}_${theme}.png`;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
                
                btn.textContent = '✓ Downloaded!';
                setTimeout(() => {
                    btn.textContent = originalText;
                    btn.classList.remove('loading');
                    btn.disabled = false;
                }, 2000);
            } catch (error) {
                console.error('Error generating PNG:', error);
                alert(error.message || 'Error generating PNG. Please try again.');
                btn.textContent = originalText;
                btn.classList.remove('loading');
                btn.disabled = false;
            }
        }
        
        async function generateWeeklyPNG() {
            if (!validateMonthYear(currentMonth, currentYear)) {
                alert('Invalid month or year');
                return;
            }
            
            const btn = event.target;
            const originalText = btn.textContent;
            btn.textContent = '⏳ Generating...';
            btn.classList.add('loading');
            btn.disabled = true;
            
            try {
                const theme = document.getElementById('themeSelect').value;
                const response = await fetch(`/api/generate/weekly/${currentYear}/${currentMonth}/1?theme=${theme}`);
                
                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.error || 'Failed to generate weekly schedule');
                }
                
                const blob = await response.blob();
                
                if (blob.type !== 'image/png') {
                    throw new Error('Invalid file type received');
                }
                
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `HackSmarter_Weekly_${monthNames[currentMonth]}_${currentYear}_${theme}.png`;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
                
                btn.textContent = '✓ Downloaded!';
                setTimeout(() => {
                    btn.textContent = originalText;
                    btn.classList.remove('loading');
                    btn.disabled = false;
                }, 2000);
            } catch (error) {
                console.error('Error generating weekly schedule:', error);
                alert(error.message || 'Error generating weekly schedule. Please try again.');
                btn.textContent = originalText;
                btn.classList.remove('loading');
                btn.disabled = false;
            }
        }
        
        // Close modal when clicking outside
        document.getElementById('eventModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });
        
        // Initialize calendar on page load
        window.addEventListener('load', initCalendar);
    </script>
</body>
</html>
